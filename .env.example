# Your DeepL API key — get one free at https://www.deepl.com/pro-api
# The only variable you must set. On Vercel, add this in the project's
# Environment Variables settings instead of committing it here.
DEEPL_API_KEY=your-key-here

# Port the local Express server listens on (optional, defaults to 3001)
PORT=3001

# Where Vite's dev proxy forwards /api (optional, defaults to localhost:3001)
VITE_API_URL=http://localhost:3001

# Origin the local backend accepts direct requests from (optional).
# Unused in normal dev, since Vite proxies /api same-origin.
ALLOWED_ORIGIN=http://localhost:5173
