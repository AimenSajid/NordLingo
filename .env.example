# Your DeepL API key — get one free at https://www.deepl.com/pro-api
DEEPL_API_KEY=your-key-here

# Where the frontend should reach the backend (optional, defaults to localhost:3001)
VITE_API_URL=http://localhost:3001

# Which origin the backend accepts requests from (optional, defaults to localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173

# Port the backend listens on (optional, defaults to 3001)
PORT=3001
